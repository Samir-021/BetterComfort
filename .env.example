# Django Secret Key (Generate a new secure random key for production)
BETTERCOMFORT_SECRET_KEY=django-insecure-p6w7#t4a4h2#wh^xtr&9a1z3wyjy5jj!=%hwa768$#wdi*8^ce

# Debug Mode (Set to False in production)
